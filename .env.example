# ==============================================================================
# GYM MEMBERSHIP MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase PostgreSQL Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Resend Email Service Configuration
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_123456789abcdef0123456789
RESEND_FROM_EMAIL=Apex Fitness <onboarding@resend.dev>

# 3. Application URL (used for email callbacks and asset paths)
NEXT_PUBLIC_APP_URL=http://localhost:3000

